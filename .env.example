# --- Server ---
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string

# --- Supabase (Postgres + storage for digital products) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Meta / Instagram Graph API ---
# Create an app at developers.facebook.com, add "Instagram Graph API" + "Webhooks" products.
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=pick-a-random-string
META_GRAPH_API_VERSION=v20.0

# --- AI provider (used for comment moderation, deal detection, message-variant rewriting) ---
# Any OpenAI-compatible endpoint works. Leave blank to fall back to keyword-only rules.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Stripe (digital product checkout) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
